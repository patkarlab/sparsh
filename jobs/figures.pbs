#!/bin/bash
#PBS -N sparsh_figures
#PBS -l select=1:ncpus=4:mem=96gb
#PBS -l walltime=12:00:00
#PBS -j oe
# Manuscript figures of a model: its training arrays, its cross-validation and a schematic (scripts/figures.py and
# figures/dmr.R; docs/FIGURES.md). CPU only. The arrays take about as much memory as the training pickle, twice
# over while it is read. Submit from the repository folder, for example:
#   qsub -v RUN_NAME=v04_labels,ANNOTATION=$HOME/refs/cpg_annotation_hg19.tsv.gz jobs/figures.pbs
# RUN_NAME is a run folder in $RUNS_DIR; the figures go to $RUNS_DIR/$RUN_NAME/figures unless OUT_DIR is given.
# EXTRA_CLASSES (separated by ':', for example AML-MR:AML_MECOM-r) adds classes left out of the model to a
# supplementary t-SNE map.
# R_ENV is the conda environment with DMRcate (envs/figures_r.yml; default sparsh_figures_r).

set -eo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
[ -f jobs/common.sh ] || { echo "ERROR: submit from the repository folder"; exit 1; }
source "${SETTINGS_FILE:-jobs/settings.sh}"
source jobs/common.sh
MODEL_DIR="$RUNS_DIR/${RUN_NAME:?Set RUN_NAME}"
require_file "run" "$MODEL_DIR/folds.csv" "No finished training run named $RUN_NAME in $RUNS_DIR"
require_file ANNOTATION "${ANNOTATION:?Set ANNOTATION (scripts/cpg_annotation.py)}"
OUT_DIR="${OUT_DIR:-$MODEL_DIR/figures}"

ARGS=(--model_dir "$MODEL_DIR" --out_dir "$OUT_DIR" --annotation "$ANNOTATION")
[ -n "${EXTRA_CLASSES:-}" ] && ARGS+=(--extra_classes ${EXTRA_CLASSES//:/ })
python scripts/figures.py tsne "${ARGS[@]}"
python scripts/figures.py markers "${ARGS[@]}"
python scripts/figures.py performance --model_dir "$MODEL_DIR" --out_dir "$OUT_DIR"
python scripts/figures.py schematic --model_dir "$MODEL_DIR" --out_dir "$OUT_DIR"

conda activate "${R_ENV:-sparsh_figures_r}"
Rscript figures/dmr.R --input "$OUT_DIR/regions_input" --out "$OUT_DIR/regions"
conda activate "$CONDA_ENV"
python scripts/figures.py regions "${ARGS[@]}"
echo "Figures in $OUT_DIR ($(date))"
