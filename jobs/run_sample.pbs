#!/bin/bash
#PBS -N sparsh_sample
#PBS -l select=1:ncpus=16:mem=48gb
#PBS -l walltime=08:00:00
#PBS -j oe
# One sample from its BAM files to its report (scripts/run_sample.py; docs/PIPELINE.md). Submit from the repository
# folder, for example:
#   qsub -v SAMPLE=S01,BAM=/data/run1/bam_pass/barcode01,OUT_DIR=/results/S01,SEX=F,BLAST=80 jobs/run_sample.pbs
# BAM is a BAM file or a folder of them; several are separated by colons. SEX (F or M) and BLAST (the blast
# percentage) are optional. The reference, the manifest, the model, the copy-number panel and the tools come from
# jobs/settings.sh; ALIGNER=minimap2 aligns with minimap2 instead of dorado. A job stopped by its walltime goes on
# where it stopped when it is submitted again with the same values.

set -eo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}"
[ -f jobs/common.sh ] || { echo "ERROR: submit from the repository folder"; exit 1; }
source "${SETTINGS_FILE:-jobs/settings.sh}"
source jobs/common.sh
IFS=: read -r -a bams <<< "${BAM:?Set BAM}"
args=(--sample "${SAMPLE:?Set SAMPLE}" --bam "${bams[@]}" --out_dir "${OUT_DIR:?Set OUT_DIR}"
      --reference "$REFERENCE_FASTA" --manifest "$EPIC_MANIFEST" --model_dir "$PIPELINE_MODEL"
      --threads "${NCPUS:-16}" --samtools "$SAMTOOLS" --modkit "$MODKIT" --aligner "${ALIGNER:-dorado}")
if [ -n "${CN_PANEL:-}" ]; then args+=(--panel "$CN_PANEL"); else args+=(--no_panel); fi
[ -z "${SEX:-}" ] || args+=(--sex "$SEX")
[ -z "${BLAST:-}" ] || args+=(--blast_percent "$BLAST")
if [ "${ALIGNER:-dorado}" = dorado ] && command -v "$DORADO" >/dev/null 2>&1; then args+=(--dorado "$DORADO"); fi
[ -z "${MINIMAP2:-}" ] || args+=(--minimap2 "$MINIMAP2")
python scripts/run_sample.py "${args[@]}"
