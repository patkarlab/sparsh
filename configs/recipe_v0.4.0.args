# Training recipe of the released model, version 0.4.0. Everything not set here is a default of scripts/train.py:
# a 1024-512-256 network with dropout 0.45, focal loss (gamma 2) with label smoothing 0.05, a class-balanced
# sampler (5 arrays per class per batch), AdamW (learning rate 1e-4, weight decay 1e-4) for up to 300 epochs,
# nested 5-fold cross-validation with an inner validation split of about one seventh (--inner_val_frac 0.15),
# temperature scaling and threshold 0.90.
#
#   python scripts/train.py @configs/recipe_v0.4.0.args --data_path ARRAYS.pkl --output_dir runs/NAME \
#       --exclude_ids EXCLUDE.txt --groups_file GROUPS.csv
#
# Options given after this file override it.

# classes left out of the model
--exclude_prefixes MPAL AML_NOS B-ALL_NOS
--exclude_classes AML-MR AML_MECOM-r

# input: one 0/1 call per covered CpG, coverage drawn per array uniformly from 2% to 95%, scaled encoding
--train_sim binary
--val_sim binary
--coverage_dist uniform
--cov_min 0.02
--cov_max 0.95
--input_encoding scaled

# dilution: each leukaemia array mixed with a normal marrow at 20-100% blasts half of the times it is drawn, the
# inner validation alike
--dilution_prob 0.5
--blast_min 0.2
--val_dilution

# scoring of the inner validation and the outer folds
--val_coverages 0.05 0.1 0.2 0.3 0.5 0.7 0.9
--eval_coverages 0.05 0.1 0.2 0.3 0.5 0.7 0.9
--eval_sims binary
--eval_blasts 1 0.5 0.3

--seed 42
